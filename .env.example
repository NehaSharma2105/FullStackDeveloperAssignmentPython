# Copy this file to .env and adjust values. Never commit .env.

DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite is the default local database (relative to the project root).
DJANGO_DATABASE_URL=sqlite:///db.sqlite3

# Redis is used as Celery broker, result backend, and rate-limiter store.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Production provider limit: 200 accepted send attempts per rolling 60 seconds.
EMAIL_RATE_LIMIT=200
EMAIL_RATE_WINDOW_SECONDS=60

# fail_closed (default): do not send if Redis is unavailable.
# fail_open: allow send if Redis is down (risks exceeding the provider cap).
EMAIL_RATE_LIMIT_ON_REDIS_ERROR=fail_closed

# Fake provider only. No real SMTP/API credentials are used.
EMAIL_PROVIDER=fake
